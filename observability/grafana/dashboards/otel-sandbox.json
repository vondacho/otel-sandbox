    {
      "type": "stat",
      "id": 2,
      "title": "Accepted orders",
      "description": "Orders accepted over the selected time range",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum(increase(orders_submitted_total{outcome=\"accepted\"}[$__range]))",
          "legendFormat": "__auto",
          "range": true
